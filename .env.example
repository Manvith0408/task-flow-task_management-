# ===================================================
# TaskFlow Environment Variables
# ===================================================

# --- Server (server/.env) ---
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas)
# Example Local: mongodb://localhost:27017/taskmanager
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/taskmanager

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL
CLIENT_URL=http://localhost:5173

